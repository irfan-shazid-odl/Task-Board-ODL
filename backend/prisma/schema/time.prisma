model TimeLog {
  id            String   @id @default(uuid()) @db.Uuid
  task_id       String?  @db.Uuid
  member_id     String?  @db.Uuid
  hours_logged  Decimal  @default(0) @db.Decimal(10, 2)
  billing_hours Decimal? @default(0) @db.Decimal(10, 2)
  log_date      DateTime @default(now()) @db.Date
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  task   Task?       @relation(fields: [task_id], references: [id], onDelete: Cascade)
  member TeamMember? @relation(fields: [member_id], references: [id], onDelete: SetNull)

  @@index([task_id])
  @@index([member_id])
  @@index([log_date])
  @@index([task_id, log_date])
  @@index([member_id, log_date])
  @@map("time_logs")
}
